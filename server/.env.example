# Salin jadi .env lalu isi. File .env JANGAN di-commit.
# Buat nilai acak: openssl rand -hex 32

DB_PASSWORD=ganti-dengan-password-acak
DB_ROOT_PASSWORD=ganti-dengan-password-acak-lain
JWT_SECRET=ganti-dengan-string-acak-panjang
NIK_SECRET=ganti-dengan-string-acak-panjang-lain

# true = kode OTP ikut dikirim ke app (untuk testing tanpa WhatsApp/SMS)
OTP_DEV_MODE=true

# Dari laptop yang sudah `cloudflared login`: cloudflared tunnel token sempat
CLOUDFLARE_TUNNEL_TOKEN=
